{
  "name": "rocky",
  "version": "1.1.0",
  "port-version": 1,
  "description": "Rocky geospatial renderer, fixed Orbelle integration build",
  "homepage": "https://github.com/pelicanmapping/rocky",
  "license": "MIT",
  "supports": "!(x86 | wasm32 | uwp)",
  "dependencies": [
    "entt",
    "glm",
    "nlohmann-json",
    { "name": "proj", "default-features": false },
    "spdlog",
    { "name": "vsg", "features": ["windowing"] },
    { "name": "vsgxchange", "features": ["freetype"] },
    { "name": "vcpkg-cmake", "host": true },
    { "name": "vcpkg-cmake-config", "host": true }
  ],
  "features": {
    "gdal": {
      "description": "Local raster imagery and elevation through GDAL",
      "dependencies": [{ "name": "gdal", "default-features": false }]
    }
  }
}
