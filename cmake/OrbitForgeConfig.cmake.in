@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(@ORBITFORGE_WITH_ERFA@)
    find_dependency(erfa 2.0.1 EXACT CONFIG)
endif()
if(@ORBITFORGE_WITH_SPICE@)
    find_dependency(unofficial-cspice CONFIG)
endif()
if(@ORBITFORGE_WITH_VSG@)
    find_dependency(vsg 1.1.15 EXACT CONFIG)
endif()
if(@ORBITFORGE_WITH_ROCKY@)
    find_dependency(rocky 1.1.0 EXACT CONFIG)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/OrbitForgeTargets.cmake")
foreach(component IN LISTS OrbitForge_FIND_COMPONENTS)
    if(TARGET OrbitForge::${component})
        set(OrbitForge_${component}_FOUND TRUE)
    else()
        set(OrbitForge_${component}_FOUND FALSE)
    endif()
endforeach()
check_required_components(OrbitForge)

