option(BUILD_TESTING "Build the C++ tests (requires GoogleTest)" OFF)
option(ORBITFORGE_BUILD_APPLICATION "Build Results, Application and Runtime" ON)
option(ORBITFORGE_WITH_ERFA "Build the ERFA time and Earth orientation provider" OFF)
option(ORBITFORGE_WITH_SPICE "Build the serialized CSPICE ephemeris provider" OFF)
option(ORBITFORGE_BUILD_VISUALIZATION "Build renderer-independent display snapshots" ON)
option(ORBITFORGE_BUILD_EXAMPLES "Build the C++ example" ON)
option(ORBITFORGE_BUILD_DATA_TOOLS "Build offline SPICE data preparation tools" OFF)
option(ORBITFORGE_BUILD_PYTHON "Build the standalone Python extension" OFF)
option(ORBITFORGE_BUILD_DESKTOP "Build the Qt Widgets workbench skeleton" OFF)
option(ORBITFORGE_WITH_VSG "Build the VSG rendering adapter" OFF)
option(ORBITFORGE_WITH_ROCKY "Build the Rocky globe display adapter" OFF)
option(ORBITFORGE_BUILD_BENCHMARKS "Build the fixed graphics benchmark workload" OFF)
option(ORBITFORGE_BUILD_COMPUTE_BENCHMARKS "Build the headless computation benchmark" OFF)
option(ORBITFORGE_INSTALL_SDK "Generate the C++ SDK install rules" ON)
option(ORBITFORGE_WARNINGS_AS_ERRORS "Treat project warnings as errors" ON)
option(ORBITFORGE_ENABLE_SANITIZERS "Enable address/undefined sanitizers on GCC/Clang" OFF)

foreach(feature VISUALIZATION EXAMPLES PYTHON DESKTOP)
    if(ORBITFORGE_BUILD_${feature} AND NOT ORBITFORGE_BUILD_APPLICATION)
        message(FATAL_ERROR "ORBITFORGE_BUILD_${feature} requires ORBITFORGE_BUILD_APPLICATION")
    endif()
endforeach()
if(ORBITFORGE_BUILD_COMPUTE_BENCHMARKS AND
   (NOT ORBITFORGE_BUILD_APPLICATION OR NOT ORBITFORGE_WITH_ERFA OR NOT ORBITFORGE_WITH_SPICE))
    message(FATAL_ERROR "The computation benchmark requires Application, ERFA and CSPICE")
endif()
if(ORBITFORGE_BUILD_DESKTOP AND NOT ORBITFORGE_BUILD_VISUALIZATION)
    message(FATAL_ERROR "The desktop skeleton requires ORBITFORGE_BUILD_VISUALIZATION")
endif()
if(ORBITFORGE_BUILD_DATA_TOOLS AND NOT ORBITFORGE_WITH_SPICE)
    message(FATAL_ERROR "SPICE data preparation tools require ORBITFORGE_WITH_SPICE")
endif()
if(ORBITFORGE_BUILD_BENCHMARKS AND
   (NOT ORBITFORGE_BUILD_DESKTOP OR NOT ORBITFORGE_WITH_ROCKY OR NOT ORBITFORGE_WITH_ERFA))
    message(FATAL_ERROR "The graphics benchmark requires the full graphical desktop")
endif()
if(ORBITFORGE_WITH_VSG AND NOT ORBITFORGE_BUILD_VISUALIZATION)
    message(FATAL_ERROR "VSG rendering requires ORBITFORGE_BUILD_VISUALIZATION")
endif()
if(ORBITFORGE_WITH_ROCKY AND NOT ORBITFORGE_WITH_VSG)
    message(FATAL_ERROR "Rocky display requires ORBITFORGE_WITH_VSG")
endif()
if(ORBITFORGE_BUILD_DESKTOP AND ORBITFORGE_WITH_VSG AND
   (NOT ORBITFORGE_WITH_ROCKY OR NOT ORBITFORGE_WITH_ERFA))
    message(FATAL_ERROR "The graphical desktop needs Rocky and ERFA for explicit Earth-fixed display")
endif()

