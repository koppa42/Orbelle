option(BUILD_TESTING "Build the C++ tests (requires GoogleTest)" OFF)
option(ORBELLE_BUILD_APPLICATION "Build Results, Application and Runtime" ON)
option(ORBELLE_WITH_ERFA "Build the ERFA time and Earth orientation provider" OFF)
option(ORBELLE_WITH_SPICE "Build the serialized CSPICE ephemeris provider" OFF)
option(ORBELLE_WITH_DATA_CATALOG "Build the SQLite data catalog and EOP source adapter" OFF)
option(ORBELLE_BUILD_VISUALIZATION "Build renderer-independent display snapshots" ON)
option(ORBELLE_BUILD_EXAMPLES "Build the C++ example" ON)
option(ORBELLE_BUILD_DATA_TOOLS "Build offline SPICE data preparation tools" OFF)
option(ORBELLE_BUILD_PYTHON "Build the standalone Python extension" OFF)
option(ORBELLE_BUILD_DESKTOP "Build the Qt Widgets workbench skeleton" OFF)
option(ORBELLE_WITH_VSG "Build the VSG rendering adapter" OFF)
option(ORBELLE_WITH_ROCKY "Build the Rocky globe display adapter" OFF)
option(ORBELLE_BUILD_BENCHMARKS "Build the fixed graphics benchmark workload" OFF)
option(ORBELLE_BUILD_COMPUTE_BENCHMARKS "Build the headless computation benchmark" OFF)
option(ORBELLE_INSTALL_SDK "Generate the C++ SDK install rules" ON)
option(ORBELLE_WARNINGS_AS_ERRORS "Treat project warnings as errors" ON)
option(ORBELLE_ENABLE_SANITIZERS "Enable address/undefined sanitizers on GCC/Clang" OFF)

foreach(feature VISUALIZATION EXAMPLES PYTHON DESKTOP)
    if(ORBELLE_BUILD_${feature} AND NOT ORBELLE_BUILD_APPLICATION)
        message(FATAL_ERROR "ORBELLE_BUILD_${feature} requires ORBELLE_BUILD_APPLICATION")
    endif()
endforeach()
if(ORBELLE_BUILD_COMPUTE_BENCHMARKS AND
   (NOT ORBELLE_BUILD_APPLICATION OR NOT ORBELLE_WITH_ERFA OR NOT ORBELLE_WITH_SPICE))
    message(FATAL_ERROR "The computation benchmark requires Application, ERFA and CSPICE")
endif()
if(ORBELLE_BUILD_DESKTOP AND NOT ORBELLE_BUILD_VISUALIZATION)
    message(FATAL_ERROR "The desktop skeleton requires ORBELLE_BUILD_VISUALIZATION")
endif()
if(ORBELLE_WITH_DATA_CATALOG AND
   (NOT ORBELLE_BUILD_APPLICATION OR NOT ORBELLE_WITH_ERFA))
    message(FATAL_ERROR "The data catalog requires Application and ERFA")
endif()
if(ORBELLE_BUILD_DATA_TOOLS AND NOT ORBELLE_WITH_SPICE)
    message(FATAL_ERROR "SPICE data preparation tools require ORBELLE_WITH_SPICE")
endif()
if(ORBELLE_BUILD_BENCHMARKS AND
   (NOT ORBELLE_BUILD_DESKTOP OR NOT ORBELLE_WITH_ROCKY OR NOT ORBELLE_WITH_ERFA))
    message(FATAL_ERROR "The graphics benchmark requires the full graphical desktop")
endif()
if(ORBELLE_WITH_VSG AND NOT ORBELLE_BUILD_VISUALIZATION)
    message(FATAL_ERROR "VSG rendering requires ORBELLE_BUILD_VISUALIZATION")
endif()
if(ORBELLE_WITH_ROCKY AND NOT ORBELLE_WITH_VSG)
    message(FATAL_ERROR "Rocky display requires ORBELLE_WITH_VSG")
endif()
if(ORBELLE_BUILD_DESKTOP AND ORBELLE_WITH_VSG AND
   (NOT ORBELLE_WITH_ROCKY OR NOT ORBELLE_WITH_ERFA))
    message(FATAL_ERROR "The graphical desktop needs Rocky and ERFA for explicit Earth-fixed display")
endif()
