@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(@ORBELLE_WITH_DATA_CATALOG@)
    find_dependency(unofficial-sqlite3 CONFIG)
endif()
if(@ORBELLE_WITH_ERFA@)
    find_dependency(erfa 2.0.1 EXACT CONFIG)
endif()
if(@ORBELLE_WITH_SPICE@)
    find_dependency(unofficial-cspice CONFIG)
endif()
if(@ORBELLE_WITH_VSG@)
    find_dependency(vsg 1.1.15 EXACT CONFIG)
endif()
if(@ORBELLE_WITH_ROCKY@)
    find_dependency(rocky 1.1.0 EXACT CONFIG)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/OrbelleTargets.cmake")
foreach(component IN LISTS Orbelle_FIND_COMPONENTS)
    if(TARGET Orbelle::${component})
        set(Orbelle_${component}_FOUND TRUE)
    else()
        set(Orbelle_${component}_FOUND FALSE)
    endif()
endforeach()
check_required_components(Orbelle)
