{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "compute-benchmark",
      "inherits": "astronomy",
      "displayName": "Headless computation throughput",
      "cacheVariables": {
        "ORBELLE_BUILD_COMPUTE_BENCHMARKS": "ON",
        "ORBELLE_BUILD_DESKTOP": "OFF",
        "ORBELLE_BUILD_VISUALIZATION": "OFF",
        "ORBELLE_BUILD_EXAMPLES": "OFF",
        "ORBELLE_BUILD_DATA_TOOLS": "OFF",
        "ORBELLE_WITH_VSG": "OFF",
        "ORBELLE_WITH_ROCKY": "OFF"
      }
    },
    {
      "name": "linux-astronomy",
      "inherits": "astronomy",
      "displayName": "Linux headless astronomy validation",
      "generator": "Ninja",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "ORBELLE_WITH_DATA_CATALOG": "ON",
        "ORBELLE_BUILD_DESKTOP": "OFF",
        "ORBELLE_WITH_VSG": "OFF",
        "ORBELLE_WITH_ROCKY": "OFF"
      }
    },
    {
      "name": "linux-sanitizers",
      "inherits": "linux-astronomy",
      "displayName": "Linux headless address and undefined behavior checks",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ORBELLE_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "graphics-benchmark",
      "inherits": "desktop-graphics",
      "displayName": "Fixed 10k satellite graphics workload",
      "cacheVariables": { "ORBELLE_BUILD_BENCHMARKS": "ON" }
    },
    {
      "name": "desktop-graphics",
      "inherits": "astronomy",
      "displayName": "Qt / VSG / Rocky graphics integration",
      "cacheVariables": {
        "ORBELLE_WITH_DATA_CATALOG": "ON",
        "ORBELLE_BUILD_DESKTOP": "ON",
        "ORBELLE_WITH_VSG": "ON",
        "ORBELLE_WITH_ROCKY": "ON"
      }
    },
    {
      "name": "headless",
      "displayName": "Headless C++ skeleton",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "headless-tests",
      "inherits": "headless",
      "displayName": "Headless with GoogleTest",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "time-frames",
      "inherits": "headless-tests",
      "displayName": "ERFA time and frame reference tests",
      "cacheVariables": {
        "ORBELLE_WITH_ERFA": "ON"
      }
    },
    {
      "name": "astronomy",
      "inherits": "time-frames",
      "displayName": "ERFA and CSPICE foundation",
      "cacheVariables": {
        "ORBELLE_WITH_SPICE": "ON",
        "ORBELLE_BUILD_DATA_TOOLS": "ON"
      }
    },
    {
      "name": "core-only",
      "inherits": "headless",
      "displayName": "Core with no application or UI dependencies",
      "cacheVariables": {
        "ORBELLE_BUILD_APPLICATION": "OFF",
        "ORBELLE_BUILD_VISUALIZATION": "OFF",
        "ORBELLE_BUILD_EXAMPLES": "OFF"
      }
    },
    {
      "name": "desktop",
      "inherits": "headless",
      "displayName": "Qt Widgets skeleton",
      "cacheVariables": {
        "ORBELLE_BUILD_DESKTOP": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "compute-benchmark", "configurePreset": "compute-benchmark", "configuration": "Release" },
    { "name": "linux-astronomy", "configurePreset": "linux-astronomy" },
    { "name": "linux-sanitizers", "configurePreset": "linux-sanitizers" },
    {
      "name": "graphics-benchmark",
      "configurePreset": "graphics-benchmark",
      "configuration": "Release"
    },
    {
      "name": "desktop-graphics",
      "configurePreset": "desktop-graphics",
      "configuration": "Release"
    },
    {
      "name": "astronomy",
      "configurePreset": "astronomy",
      "configuration": "Release"
    },
    {
      "name": "time-frames",
      "configurePreset": "time-frames",
      "configuration": "Release"
    },
    {
      "name": "headless",
      "configurePreset": "headless",
      "configuration": "Release"
    },
    {
      "name": "headless-tests",
      "configurePreset": "headless-tests",
      "configuration": "Release"
    },
    {
      "name": "core-only",
      "configurePreset": "core-only",
      "configuration": "Release"
    },
    {
      "name": "desktop",
      "configurePreset": "desktop",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "compute-benchmark",
      "configurePreset": "compute-benchmark",
      "configuration": "Release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "linux-astronomy",
      "configurePreset": "linux-astronomy",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "linux-sanitizers",
      "configurePreset": "linux-sanitizers",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    },
    {
      "name": "graphics-benchmark",
      "configurePreset": "graphics-benchmark",
      "configuration": "Release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "desktop-graphics",
      "configurePreset": "desktop-graphics",
      "configuration": "Release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "astronomy",
      "configurePreset": "astronomy",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "time-frames",
      "configurePreset": "time-frames",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "headless-tests",
      "configurePreset": "headless-tests",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
